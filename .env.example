PROJECT_NAME=HCM Lite
# Database: PostgreSQL for production (postgresql://user:password@host:5432/dbname), SQLite for local
DATABASE_URL=sqlite:///./hcm_lite.db
SECRET_KEY=your_secret_key_min_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS origins (comma-separated list or * for all)
CORS_ORIGINS=*

# First-run bootstrap (leave commented out so judges see the first-run /setup wizard)
# COMPANY_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# AI Integration (Google Gemini API - backend only)
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Frontend environment
VITE_API_URL=http://localhost:8000
