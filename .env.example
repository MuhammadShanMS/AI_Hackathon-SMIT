PROJECT_NAME=HCM Lite
# Database: PostgreSQL for production (postgresql://user:pass@host:5432/dbname), SQLite for local
DATABASE_URL=sqlite:///./hcm_lite.db
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS origins
CORS_ORIGINS=*

# Optional first-run bootstrap credentials
COMPANY_NAME=Saylani Welfare International Trust
ADMIN_EMAIL=admin@saylani.org
ADMIN_PASSWORD=AdminSecurePass123!

# AI Integration (Google Gemini API - backend only)
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Frontend environment
VITE_API_URL=http://localhost:8000
